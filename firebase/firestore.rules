// WatchOut Firestore 보안 규칙 (#49, #66, #50)
//
// 적용 방법: Firebase 콘솔 → Firestore Database → 규칙 탭에 이 파일 내용을 붙여넣고 "게시".
// 이 파일이 기준이다. 콘솔에서 고쳤다면 이 파일도 같이 고친다.
//
// 원칙
// - 기본은 전부 거부한다. 아래에 적은 경로만 허용한다.
// - 보호자 연락처는 로그인한 "본인"만 읽고 쓸 수 있다.
// - 응급 알림은 본인 + 본인이 초대해서 연결된 보호자만 읽을 수 있다 (#50).
// - 앱의 검사 코드(GuardianValidator, InviteCode)와 같은 규칙으로 값을 한 번 더 검사한다.
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // 로그인한 사람이 이 환자와 연결된 보호자인가: users/{환자}/links/{내 uid} 문서가 있으면 "예"
    function isLinkedGuardian(patientUid) {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(patientUid)/links/$(request.auth.uid));
    }

    function isShortName(s) {
      return s is string && s.size() >= 1 && s.size() <= 50;
    }

    // 앱(GuardianValidator)과 같은 규칙: 이름 1~20자, 관계 1~10자, 휴대폰 번호 숫자만
    function isValidGuardian(d) {
      return d.keys().hasOnly(['name', 'relation', 'phone', 'updatedAt'])
        && d.name is string && d.name.size() >= 1 && d.name.size() <= 20
        && d.relation is string && d.relation.size() >= 1 && d.relation.size() <= 10
        && d.phone is string && d.phone.matches('^01[016789][0-9]{7,8}$')
        && d.updatedAt == request.time;
    }

    // 사용자 모드(#66): role은 "patient"(본인) 또는 "guardian"(보호자)만
    // request.resource.data = 저장한 뒤의 문서 전체 (merge로 저장해도 전체를 검사한다)
    function isValidProfile(d) {
      return d.keys().hasOnly(['role', 'updatedAt'])
        && d.role in ['patient', 'guardian']
        && d.updatedAt == request.time;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidProfile(request.resource.data);
    }

    match /users/{uid}/guardians/{guardianId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isValidGuardian(request.resource.data);
    }

    // ── 환자 ↔ 보호자 연결 (#50) ─────────────────────────────

    // 초대 코드: 문서 이름이 6자리 코드. 환자가 만들고, 10분 동안 유효, 쓰면 지운다.
    // - 코드를 아는 사람(문자를 받은 보호자)만 하나씩 읽을 수 있다(get). 목록 조회(list)는 막는다.
    // - 만든 시각은 서버 시각(createdAt == request.time)이라 폰 시계를 바꿔도 소용없다.
    match /invites/{code} {
      allow get: if isSignedIn();
      allow create: if isSignedIn()
        && code.matches('^[0-9]{6}$')
        && request.resource.data.keys().hasOnly(['patientUid', 'patientName', 'guardianId', 'createdAt'])
        && request.resource.data.patientUid == request.auth.uid
        && isShortName(request.resource.data.patientName)
        && request.resource.data.guardianId is string
        // 초대는 내가 등록한 보호자 연락처 앞으로만 만들 수 있다
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/guardians/$(request.resource.data.guardianId))
        && request.resource.data.createdAt == request.time;
      // 만든 환자, 또는 이 코드로 방금 연결한 보호자(같은 묶음 쓰기)만 지울 수 있다
      allow delete: if isOwner(resource.data.patientUid)
        || (isSignedIn() && existsAfter(/databases/$(database)/documents/users/$(resource.data.patientUid)/links/$(request.auth.uid)));
    }

    // 연결 허락증: "이 보호자(guardianUid)는 내 응급 알림을 봐도 돼요"
    // 보호자가 아직 유효한 초대 코드를 가지고 있을 때만 만들 수 있다.
    match /users/{patientUid}/links/{guardianUid} {
      allow read: if isOwner(patientUid) || isOwner(guardianUid);
      allow create: if isOwner(guardianUid)
        && guardianUid != patientUid
        && isValidLink(request.resource.data, patientUid);
      // 환자도, 보호자도 연결을 끊을 수 있다
      allow delete: if isOwner(patientUid) || isOwner(guardianUid);
    }

    function isValidLink(d, patientUid) {
      let invite = get(/databases/$(database)/documents/invites/$(d.inviteCode)).data;
      return d.keys().hasOnly(['guardianId', 'guardianName', 'inviteCode', 'linkedAt'])
        && d.inviteCode is string && d.inviteCode.matches('^[0-9]{6}$')
        && isShortName(d.guardianName)
        && d.linkedAt == request.time
        && invite.patientUid == patientUid
        && invite.guardianId == d.guardianId
        && request.time < invite.createdAt + duration.value(10, 'm');
    }

    // 보호자가 연결한 환자 목록 (보호자 화면용). 환자 쪽 허락증이 있어야 만들 수 있다.
    match /users/{guardianUid}/patients/{patientUid} {
      allow read, delete: if isOwner(guardianUid);
      allow create, update: if isOwner(guardianUid)
        && request.resource.data.keys().hasOnly(['name', 'linkedAt'])
        && isShortName(request.resource.data.name)
        && request.resource.data.linkedAt == request.time
        && existsAfter(/databases/$(database)/documents/users/$(patientUid)/links/$(guardianUid));
    }

    // ── 응급 알림 (#50) ──────────────────────────────────────
    // 쓰러짐이 확정됐을 때만 만든다. 사진은 응급 확정 때 한 장만, 500KB 이하.
    // 119는 실제로 연락하지 않는다 → call119는 항상 "simulated".
    // (나중에 로봇카는 서버용 관리자 키로 쓰므로 이 규칙을 거치지 않는다. 관리자 키는 커밋하지 않는다.)
    match /users/{patientUid}/alerts/{alertId} {
      allow read: if isOwner(patientUid) || isLinkedGuardian(patientUid);
      allow create: if isOwner(patientUid) && isValidAlert(request.resource.data);
      // 보호자는 [확인했어요] 필드만, 아직 아무도 확인하지 않았을 때 한 번만 쓸 수 있다
      allow update: if isLinkedGuardian(patientUid)
        && !('ackedBy' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ackedBy', 'ackedByName', 'ackedAt'])
        && request.resource.data.ackedBy == request.auth.uid
        && isShortName(request.resource.data.ackedByName)
        && request.resource.data.ackedAt == request.time;
    }

    function isValidAlert(d) {
      return d.keys().hasOnly(['kind', 'source', 'moving', 'call119', 'photo', 'createdAt'])
        && d.kind == 'fall'
        && d.source in ['test', 'robot']
        && d.moving is bool
        && d.call119 == 'simulated'
        && (!('photo' in d) || (d.photo is bytes && d.photo.size() <= 512000))
        && d.createdAt == request.time;
    }
  }
}
