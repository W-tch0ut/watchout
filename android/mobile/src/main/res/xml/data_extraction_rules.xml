<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12 이상: 클라우드 백업과 새 폰으로 옮기기(기기 간 전송) 모두에서
    앱 데이터(로그인 세션 포함)를 빼낸다. 새 폰에서는 다시 로그인하면 된다.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
