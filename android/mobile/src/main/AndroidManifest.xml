<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Firebase 로그인·Firestore 통신 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 로봇카 찾기: 같은 Wi-Fi의 UDP 방송을 듣는다 (#42 데모) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- 로봇카와 MQTT 연결을 앱 화면이 닫혀도 유지한다 (#42 데모).
         connectedDevice 종류는 위의 CHANGE_WIFI_MULTICAST_STATE 같은 연결 권한이 있어야 시작된다 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        로그인 정보(Firebase 세션)와 앱 데이터가 구글 드라이브 백업이나 다른 기기로 복사되지 않게 막는다.
        allowBackup="false": Android 11 이하 / dataExtractionRules: Android 12 이상
        (Android 11 이하는 allowBackup="false"로 이미 백업이 꺼져서 fullBackupContent가 필요 없다 → lint 경고 무시)
    -->
    <application
        android:name=".WatchOutApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:ignore="DataExtractionRules"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 로봇카와 MQTT 연결 유지 + 워치 명령 전달 (#42 데모) -->
        <service
            android:name=".car.CarConnectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- 워치가 보낸 명령·낙상·제스처 등록 상황·제스처 목록 받기 (Wear OS Data Layer) -->
        <service
            android:name=".car.WatchMessageListener"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:host="*"
                    android:pathPrefix="/watchout/msg"
                    android:scheme="wear" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:host="*"
                    android:pathPrefix="/watchout/gestures"
                    android:scheme="wear" />
            </intent-filter>
        </service>
    </application>
</manifest>
