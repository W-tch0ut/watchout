<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 워치 전용 앱 -->
    <uses-feature android:name="android.hardware.type.watch" />
    <!-- 제스처 인식에 가속도·자이로가 꼭 필요하다 -->
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="true" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="true" />

    <!-- 인식·녹화 결과를 진동으로 알려준다 -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- 삼성 제스처 수집: 심박 원시 신호(PPG)를 읽는다. 처음 쓸 때 사용자에게 허용을 묻는다 -->
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <!-- 음성 명령(#69): 버튼을 누르는 동안만 마이크를 쓴다. 처음 쓸 때 사용자에게 허용을 묻는다.
         인식은 기기 안에서만 하고, 녹음은 저장하거나 밖으로 보내지 않는다. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 마이크가 없는 워치에도 설치는 되게 한다(음성 화면만 못 쓴다) -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Android 11+ 에서 음성 인식 서비스를 찾으려면 이 선언이 있어야 한다 -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
    <!-- 가속도·자이로는 200Hz로 읽는다. 200Hz까지는 HIGH_SAMPLING_RATE_SENSORS 권한이 필요 없다 -->


    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- 폰 앱 없이 워치 혼자 동작한다 -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
